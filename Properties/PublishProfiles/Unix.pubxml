<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <NexLauncherPlatform>Unix</NexLauncherPlatform>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <!-- Loose native libraries simplify macOS signing and Linux loader diagnostics. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ErrorOnDuplicatePublishOutputFiles>true</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
</Project>
