<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexLauncher.ViewModels"
        xmlns:models="using:NexLauncher.Models"
        xmlns:views="using:NexLauncher.Views"
        x:Class="NexLauncher.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Classes="qc-app" Title="NexLauncher"
        Width="1060" Height="760" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="196,*">
        <Border Classes="qc-sidebar">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14,28,14,20">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="9,0,0,32">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource NxAccentBrush}">
                        <TextBlock Text="N" FontSize="18" FontWeight="Bold" Foreground="#103429"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="NexLauncher" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="6">
                    <Button Classes="nav" Classes.active="{Binding IsPlayPage}" Command="{Binding NavigateCommand}" CommandParameter="play">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Width="15" Height="15" Data="M 3,1 L 18,10 L 3,19 Z"/>
                            <TextBlock Text="Играть"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsInstancesPage}" Command="{Binding NavigateCommand}" CommandParameter="instances">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Width="15" Height="15" Data="M 1,1 L 8,1 L 8,8 L 1,8 Z M 11,1 L 18,1 L 18,8 L 11,8 Z M 1,11 L 8,11 L 8,18 L 1,18 Z M 11,11 L 18,11 L 18,18 L 11,18 Z"/>
                            <TextBlock Text="Сборки"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsPacksPage}" Command="{Binding NavigateCommand}" CommandParameter="modrinth" Content="Modrinth"/>
                    <Button Classes="nav" Classes.active="{Binding IsSettingsPage}" Command="{Binding NavigateCommand}" CommandParameter="settings">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Width="15" Height="15" Data="M 2,4 L 20,4 L 20,6 L 2,6 Z M 2,10 L 20,10 L 20,12 L 2,12 Z M 2,16 L 20,16 L 20,18 L 2,18 Z M 6,2 L 9,2 L 9,8 L 6,8 Z M 14,8 L 17,8 L 17,14 L 14,14 Z M 7,14 L 10,14 L 10,20 L 7,20 Z"/>
                            <TextBlock Text="Настройки"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="12,0" Spacing="6">
                    <TextBlock Text="Твой мир. Твои сборки." FontSize="11" Classes="muted"/>
                    <TextBlock Text="NexLauncher · 0.1" FontSize="11" Foreground="#78828D"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Classes="qc-content" Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,26">
                <TextBlock Text="MINECRAFT: JAVA EDITION" FontSize="11" FontWeight="SemiBold"
                           Foreground="#8F9AA5" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Classes="qc-account-panel">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource NxAccentBrush}" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{Binding Accounts.Initial}" IsVisible="{Binding Accounts.HasNoAvatar}" Foreground="#103429" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                <Image Source="{Binding Accounts.Avatar}" IsVisible="{Binding Accounts.HasAvatar}" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AccountName}" FontSize="13" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Accounts.AccountTypeLabel}" FontSize="10" Classes="muted" IsVisible="{Binding HasAccount}"/>
                        </StackPanel>
                        <Button Content="Аккаунты" Command="{Binding NavigateCommand}" CommandParameter="settings"/>
                    </StackPanel>
                </Border>
            </Grid>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18" Margin="0,0,4,16">
                    <StackPanel IsVisible="{Binding IsPlayPage}" Spacing="22">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding HeroTitle}" Classes="title"/>
                            <TextBlock Text="Один шаг до следующего приключения." Classes="muted"/>
                        </StackPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding HasInstance}">
                            <TextBlock Text="Выбранная сборка" Classes="caption"/>
                            <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" IsEnabled="{Binding IsEditable}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameInstance">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Border Classes="card qc-instance-card">
                            <StackPanel Spacing="22">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="56" Height="56" Background="#293D35" CornerRadius="12" Margin="0,0,16,0">
                                        <PathIcon Width="28" Height="28" Foreground="{DynamicResource NxAccentBrush}"
                                                  Data="M 10,0 L 20,5 L 10,10 L 0,5 Z M 0,7 L 9,12 L 9,23 L 0,18 Z M 11,12 L 20,7 L 20,18 L 11,23 Z"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock Text="{Binding InstanceTitle}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding InstanceDetails}" Classes="muted"/>
                                    </StackPanel>
                                </Grid>
                                <Border Background="#3B4148" Height="1"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center" Spacing="5" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding InstallState}" FontWeight="Medium" IsVisible="{Binding HasInstance}"/>
                                        <TextBlock Text="{Binding StatusText}" Classes="caption" TextWrapping="Wrap" MaxWidth="430" HorizontalAlignment="Left"/>
                                        <Button Content="Открыть папку" Classes="quiet" Command="{Binding OpenFolderCommand}" IsVisible="{Binding HasInstance}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primary qc-play-button" Content="{Binding PrimaryButtonText}" Command="{Binding PrimaryCommand}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <WrapPanel IsVisible="{Binding HasInstance}">
                            <Button Content="Моды" Command="{Binding NavigateCommand}" CommandParameter="mods" IsVisible="{Binding CanOpenMods}" Margin="0,0,8,0"/>
                            <Button Content="Настройки сборки" Command="{Binding NavigateCommand}" CommandParameter="settings"/>
                        </WrapPanel>
                        <TextBlock Text="Версия, миры и настройки хранятся отдельно для каждой сборки."
                                   Classes="caption" TextWrapping="Wrap"/>
                        <Border Background="#202725" CornerRadius="10" Padding="18,15" IsVisible="{Binding HasNoAccount}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Выбери способ игры" FontWeight="Medium" Foreground="#C8E4D7"/>
                                <TextBlock Text="Войди через Microsoft или создай локальный аккаунт. Сборки и установка доступны до выбора аккаунта."
                                           TextWrapping="Wrap" Classes="caption"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Войти через Microsoft" Command="{Binding SignInCommand}" Margin="0,0,8,8"/>
                                    <Button Content="Локальный аккаунт" Command="{Binding NavigateCommand}" CommandParameter="settings" Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Static vm:AccountsViewModel.LocalLimitations}"
                                   IsVisible="{Binding Accounts.IsLocalAccount}" Classes="caption" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsInstancesPage}" Spacing="22">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Мои сборки" Classes="title"/>
                            <TextBlock Text="Отдельное место для каждого мира." Classes="muted"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                                 IsEnabled="{Binding IsEditable}" IsVisible="{Binding HasInstance}"
                                 Background="Transparent" BorderThickness="0" MaxHeight="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:GameInstance">
                                    <Grid ColumnDefinitions="*,Auto" Margin="8,8">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VersionId}" Classes="caption" Margin="16,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Classes="card">
                            <StackPanel Spacing="16" IsEnabled="{Binding IsEditable}">
                                <TextBlock Text="Создать сборку" FontSize="18" FontWeight="SemiBold"/>
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Название" Classes="caption"/>
                                    <TextBox Text="{Binding NewInstanceName}" MaxLength="60" PlaceholderText="Например, выживание с друзьями"/>
                                </StackPanel>
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Версия Minecraft" Classes="caption" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VersionCount}" Classes="caption"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" PlaceholderText="Выбери версию">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:MinecraftRelease">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox Content="Показывать снапшоты" IsChecked="{Binding IncludeSnapshots}" FontSize="12"/>
                                        <Button Grid.Column="1" Content="Обновить" Classes="quiet" Command="{Binding RefreshVersionsCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="7" DataContext="{Binding LoaderOptions}" x:DataType="vm:LoaderOptionsViewModel">
                                    <TextBlock Text="Загрузчик" Classes="caption"/>
                                    <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding Loader}"/>
                                    <TextBlock Text="Версия загрузчика" Classes="caption" IsVisible="{Binding NeedsVersion}"/>
                                    <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedRelease}" IsVisible="{Binding NeedsVersion}" PlaceholderText="Совместимая версия"/>
                                    <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Content="Создать сборку" Classes="primary" Command="{Binding CreateInstanceCommand}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Перейти к игре" Command="{Binding NavigateCommand}" CommandParameter="play" IsVisible="{Binding HasInstance}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsModrinthPage}"><views:ModrinthView DataContext="{Binding Catalog}"/></StackPanel>
                    <StackPanel IsVisible="{Binding IsSettingsPage}" Spacing="22">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Настройки" Classes="title"/>
                            <TextBlock Text="Всё нужное для комфортной игры." Classes="muted"/>
                        </StackPanel>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Папка сборок" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding InstancesDirectory}" TextWrapping="Wrap" Classes="caption"/>
                                <Button Content="Выбрать папку…" Command="{Binding ChooseInstancesFolderCommand}" HorizontalAlignment="Left"/>
                                <TextBlock Text="Новые сборки будут создаваться здесь. Существующие останутся в своих папках." TextWrapping="Wrap" Classes="caption"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" IsVisible="{Binding HasInstance}">
                            <StackPanel Spacing="18" IsEnabled="{Binding IsEditable}">
                                <TextBlock Text="{Binding InstanceTitle}" FontSize="18" FontWeight="SemiBold"/>
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Оперативная память"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MemoryLabel}" Foreground="{DynamicResource NxAccentBrush}"/>
                                    </Grid>
                                    <Slider Minimum="1" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MemoryGb}"/>
                                    <TextBlock Text="Для Vanilla начни с 4 ГБ. Оставь память для системы и других приложений." Classes="caption" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Java"/>
                                    <TextBox Text="{Binding JavaPath}" PlaceholderText="Автоматически — оставь поле пустым"/>
                                    <TextBlock Text="Если нужна своя Java, укажи полный путь к java или javaw." Classes="caption" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel DataContext="{Binding Accounts}" x:DataType="vm:AccountsViewModel" Spacing="12">
                                <TextBlock Text="Аккаунты Minecraft" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding MicrosoftWarning}" IsVisible="{Binding HasMicrosoftWarning}" Classes="caption" TextWrapping="Wrap"/>
                                <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedAccount}" IsVisible="{Binding HasAccount}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:LauncherAccount">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Username}"/>
                                                <TextBlock Text="{Binding TypeLabel}" Classes="caption" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Использовать" Command="{Binding ActivateCommand}" IsVisible="{Binding HasAccount}" Margin="0,0,8,8"/>

                                    <Button Content="Выйти / удалить" Command="{Binding RemoveCommand}" IsVisible="{Binding HasAccount}" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <TextBlock Text="Microsoft Account" FontWeight="SemiBold"/>
                                <Button Content="Войти через Microsoft" Command="{Binding AddCommand}" HorizontalAlignment="Left"/>
                                <TextBlock Text="Для игры с авторизованной сессией. Пароль вводится только в окне Microsoft." Classes="caption" TextWrapping="Wrap"/>
                                <TextBlock Text="Играть без Microsoft · Локальный аккаунт" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding LocalUsername}" MaxLength="16" PlaceholderText="Minecraft-ник, например Alex_123"/>
                                <TextBlock Text="От 3 до 16 латинских букв, цифр или _. Регистр влияет на локальный UUID." Classes="caption" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LocalError}" IsVisible="{Binding HasLocalError}" Classes="caption" TextWrapping="Wrap"/>
                                <Button Content="Создать локальный аккаунт" Command="{Binding CreateLocalCommand}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{x:Static vm:AccountsViewModel.LocalLimitations}" Classes="caption" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel DataContext="{Binding QuickCss}" x:DataType="vm:QuickCssViewModel" Spacing="12">
                                <TextBlock Text="Quick CSS" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Твоя тема поверх стандартного оформления. Цвета, фон, шрифты и детали интерфейса." Classes="muted" TextWrapping="Wrap"/>
                                <CheckBox Content="Включить Quick CSS" IsChecked="{Binding Enabled}"/>
                                <TextBox Text="{Binding FilePath}" PlaceholderText="Полный путь к .css файлу"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Выбрать файл" Command="{Binding BrowseCommand}" Margin="0,0,8,8"/>
                                    <Button Content="Открыть в редакторе" Command="{Binding OpenCommand}" Margin="0,0,8,8"/>
                                    <Button Content="Создать пример" Command="{Binding CreateExampleCommand}" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <CheckBox Content="Обновлять после сохранения файла" IsChecked="{Binding AutoReload}"/>
                                <TextBlock Text="«Применить» сохраняет выбранный файл и переключатели. «Перезагрузить» также перечитывает тему." Classes="caption" TextWrapping="Wrap"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Применить" Command="{Binding ApplyCommand}" Margin="0,0,8,8"/>
                                    <Button Content="Перезагрузить" Command="{Binding ReloadCommand}" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Diagnostics}" IsVisible="{Binding HasDiagnostics}" Classes="caption" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Сохранить настройки" Classes="primary" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right"/>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Папка данных" Classes="caption"/>
                            <TextBlock Text="{Binding DataDirectory}" FontSize="12" Foreground="#7F8A95" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Notice}" IsVisible="{Binding HasNotice}" Foreground="#A6CFBB" TextWrapping="Wrap"/>
                    <Border Classes="card qc-log-panel" IsVisible="{Binding ShowLog}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Журнал запуска" FontWeight="Medium" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Открыть файл" Classes="quiet" Command="{Binding OpenLogCommand}"/>
                            </Grid>
                            <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="180" FontFamily="Consolas, monospace" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,0">
                <Border Background="#3A262A" BorderBrush="#75414A" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="{Binding HasError}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" MaxLines="4" TextTrimming="WordEllipsis" Foreground="#F2C9CE"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Показать журнал" Command="{Binding ToggleLogCommand}"/>
                            <Button Content="Скрыть" Command="{Binding DismissErrorCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="6" IsVisible="{Binding ShowProgress}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding StatusText}" Classes="caption" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Content="Отменить" Classes="quiet" Command="{Binding CancelCommand}"/>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Независимый лаунчер · не связан с Mojang или Microsoft"
                               FontSize="10" Foreground="#7F8A95" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="Журнал" Classes="quiet" Command="{Binding ToggleLogCommand}" FontSize="12" Margin="12,0,0,0"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>


