<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NexLauncher.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <Color x:Key="NxAccentColor">#78D9B3</Color>
        <SolidColorBrush x:Key="NxAccentBrush" Color="{DynamicResource NxAccentColor}"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="{DynamicResource NxAccentColor}"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <Style Selector="Border.qc-sidebar">
            <Setter Property="Background" Value="#202225"/>
            <Setter Property="BorderBrush" Value="#30343A"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style Selector="Grid.qc-content">
            <Setter Property="Margin" Value="32,24,32,20"/>
        </Style>
        <Style Selector="Window">
            <Setter Property="Background" Value="#181A1D"/>
            <Setter Property="Foreground" Value="#EDF0F3"/>
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#ABB3BC"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#ABB3BC"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Background" Value="#2B2E33"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource NxAccentBrush}"/>
            <Setter Property="Foreground" Value="#103429"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#96E5C5"/>
            <Setter Property="Foreground" Value="#103429"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#334D43"/>
            <Setter Property="Foreground" Value="#BBC9C2"/>
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9C0C8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#293D35"/>
            <Setter Property="Foreground" Value="{DynamicResource NxAccentBrush}"/>
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NxAccentBrush}"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#293D35"/>
            <Setter Property="Foreground" Value="#EDF0F3"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#202327"/>
            <Setter Property="BorderBrush" Value="#3B4148"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#26292D"/>
            <Setter Property="BorderBrush" Value="#3B4148"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#26292D"/>
            <Setter Property="BorderBrush" Value="#3B4148"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource NxAccentBrush}"/>
            <Setter Property="Background" Value="#363C3A"/>
            <Setter Property="Height" Value="5"/>
        </Style>

        <Style Selector="Button.project-card">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#25282D"/>
            <Setter Property="BorderBrush" Value="#383E44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style Selector="Button.skin-card">
            <Setter Property="Background" Value="#25282D"/>
            <Setter Property="BorderBrush" Value="#383E44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Application.Styles>
</Application>
